@using System.Security.Claims
@{
    Layout = null;
    string vaiTro = User.FindFirstValue(ClaimTypes.Role) ?? "Staff";
    string tenHienThi = User.FindFirstValue("displayName") ?? "Nhân viên";
    string chuCaiDau = string.IsNullOrWhiteSpace(tenHienThi) ? "N" : tenHienThi[..1];
    string tenVaiTro = vaiTro switch
    {
        "Manager" => "Quản lý",
        "Cashier" => "Thu ngân",
        "Mechanic" => "Thợ sửa xe",
        _ => "Nhân viên"
    };
}
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>Cửa Hàng Sửa Xe · Quản lý sửa xe</title>
        <link rel="stylesheet" href="~/css/quan-ly.css" asp-append-version="true" />
    </head>
    <body data-role="@vaiTro">
        <button class="mobile-toggle" id="menu-toggle" aria-label="Mở menu">☰</button>
        <aside class="ws-sidebar" id="sidebar">
            <a href="/" class="ws-brand">
                <span>SX</span>
                <div>
                    SỬA<span class="accent">XE</span>
                    <small>QUẢN LÝ XƯỞNG SỬA XE</small>
                </div>
            </a>
            <div class="workspace-label">KHÔNG GIAN LÀM VIỆC</div>
            <nav id="navigation" aria-label="Các chức năng"></nav>
            <div class="sidebar-bottom">
                <a href="/">↗ Website khách hàng</a>
                <div class="profile">
                    <span class="avatar">@chuCaiDau</span>
                    <div>
                        <b>@tenHienThi</b>
                        <small>@tenVaiTro</small>
                    </div>
                    <button id="logout" title="Đăng xuất" aria-label="Đăng xuất">↪</button>
                </div>
            </div>
        </aside>
        <div class="ws-main">
            <header class="ws-top">
                <div>
                    <span class="eyebrow">CỬA HÀNG SỬA XE / VẬN HÀNH</span>
                    <h1 id="page-title">Tổng quan cửa hàng</h1>
                </div>
                <div class="top-actions">
                    <span class="database-status" id="db-status">● Đang kết nối</span>
                    <span id="today"></span>
                </div>
            </header>
            <main id="content" tabindex="-1">
                <div class="empty">Đang tải dữ liệu cửa hàng…</div>
            </main>
            <footer class="ws-footer">
                <b>CỬA HÀNG SỬA XE</b>
                <span>Khách hàng · Sửa chữa · Kho · Nhân sự · Doanh thu</span>
            </footer>
        </div>
        <dialog id="editor" class="ws-dialog">
            <form id="editor-form">
                <div class="dialog-heading">
                    <div>
                        <span class="eyebrow">QUẢN LÝ CỬA HÀNG</span>
                        <h2 id="editor-title"></h2>
                    </div>
                    <button type="button" class="icon-button" id="close-editor" aria-label="Đóng">
                        ×
                    </button>
                </div>
                <div id="editor-body"></div>
                <p class="form-error" id="editor-error" role="alert"></p>
                <div class="dialog-actions">
                    <button type="button" class="button secondary" id="cancel-editor">Đóng</button>
                    <button class="button primary" id="save-editor">Lưu thông tin</button>
                </div>
            </form>
        </dialog>
        <partial name="_GoiYXeMay" />
        <div class="toast" id="toast" role="status" hidden></div>
        <script src="~/js/goi-api.js" asp-append-version="true"></script>
        <script src="~/js/quan-ly.js" asp-append-version="true"></script>
    </body>
</html>
